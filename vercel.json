  "outputDirectory": "emotionally-adaptive-learning-main/dist",
  "installCommand": "cd emotionally-adaptive-learning-main && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
